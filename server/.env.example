# ========== 基础 ==========
PORT=3000
HOST=0.0.0.0

# 存储模式: memory(无 Redis 本地直跑) | redis(生产/多实例)
STORE_MODE=memory

# ========== Redis（STORE_MODE=redis 时必填） ==========
REDIS_URL=redis://localhost:6379

# ========== LiveKit（不配置则进入"演示模式"：房间流程可用，语音不可用） ==========
# LiveKit 服务端 API Key/Secret（部署时在 livekit.yaml 中设置相同值）
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# 客户端连接用的 wss 地址（浏览器连接）
LIVEKIT_URL=wss://lk.example.com
# 服务端管理 API 用的 http 地址（用于回收房间）
LIVEKIT_HOST=http://lk.example.com

# ========== 业务参数 ==========
ROOM_MAX_MEMBERS=10
HEARTBEAT_TIMEOUT_MS=90000
