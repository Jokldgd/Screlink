# ===== Screlink 公网部署（Docker）=====

# 二选一：
#  - IP 模式（免备案，推荐）：只填 PUBLIC_IP，用 ip 模式 compose
#  - 域名模式（需备案或海外）：填 DOMAIN，用默认 compose（Caddy 自动 HTTPS）

# 1) 公网 IP（阿里云实例的公网 IP）
PUBLIC_IP=121.199.163.15

# 2) 域名（可选；IP 模式可留空）
DOMAIN=

# 3) TURN 用户名 / 密码（请改成强密码）
TURN_USER=screlink
TURN_PASS=please-change-me

# 4) SFU（LiveKit）接入（多人数/直播场景，见 docs/SFU.md；不用可留空）
#    生成方式：任意随机串（LIVEKIT_API_KEY 用字符串，SECRET 用 ≥32 字符随机）
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=please-change-this-to-a-random-secret-32chars
