# ===== Screlink 公网部署（Docker）=====

# 二选一：
#  - IP 模式（免备案，推荐）：只填 PUBLIC_IP，用 ip 模式 compose
#  - 域名模式（需备案或海外）：填 DOMAIN，用默认 compose（Caddy 自动 HTTPS）

# 1) 公网 IP（阿里云实例的公网 IP）
PUBLIC_IP=121.199.163.15

# 2) 域名（可选；IP 模式可留空）
DOMAIN=

# 3) TURN 用户名 / 密码（请改成强密码）
TURN_USER=screlink
TURN_PASS=please-change-me

# 4) SFU（LiveKit）接入（多人数/直播场景，见 docs/SFU.md；不用可留空）
#    注意：LIVEKIT_API_SECRET 请用【纯字母数字/十六进制】随机串（≥32 字符），
#          避免特殊字符（如 % * + ! @ ? =）破坏 LiveKit 的 "key: secret" 解析。
#    生成示例：openssl rand -hex 24  或  手动用 0-9a-f 拼 48 位
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=0123456789abcdef0123456789abcdef01234567
